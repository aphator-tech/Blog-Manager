{
  "entities": {
    "Agent": {
      "title": "Agent",
      "description": "An autonomous AI agent in the Meta.co ecosystem.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "personality": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "tasks": { "type": "array", "items": { "type": "string" } },
        "inputFormat": { "type": "string" },
        "outputFormat": { "type": "string" },
        "primaryLayer": { "type": "string", "enum": ["FRONT", "OFFICE", "BACK"] },
        "status": { "type": "string", "enum": ["idle", "working", "thinking", "done"] },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "A specific task assigned to an agent.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agentId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed"] },
        "layer": { "type": "string", "enum": ["FRONT", "OFFICE", "BACK"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "agentId", "title", "status", "layer", "timestamp"]
    },
    "ContentItem": {
      "title": "ContentItem",
      "description": "A piece of content generated by the agents.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["Tech", "Games", "AI", "Automation", "Crypto", "News"] },
        "type": { "type": "string", "enum": ["Guide", "Tool", "Script", "News", "Review"] },
        "isEvergreen": { "type": "boolean" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "rpm": { "type": "number" }
      },
      "required": ["id", "title", "category", "type", "date"]
    },
    "Metric": {
      "title": "Metric",
      "description": "A key performance indicator for the business.",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "trend": { "type": "string", "enum": ["up", "down", "neutral"] },
        "category": { "type": "string", "enum": ["Traffic", "Revenue", "SEO"] }
      },
      "required": ["label", "value", "trend", "category"]
    },
    "Log": {
      "title": "Log",
      "description": "A system log entry.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "timestamp"]
    }
  },
  "firestore": {
    "agents": { "schema": "Agent", "description": "Collection of autonomous agents." },
    "tasks": { "schema": "Task", "description": "Collection of tasks for agents." },
    "content": { "schema": "ContentItem", "description": "Collection of generated content." },
    "metrics": { "schema": "Metric", "description": "Collection of business metrics." },
    "logs": { "schema": "Log", "description": "Collection of system logs." }
  }
}
